{
  "info": {
    "name": "02 — Practitioner",
    "description": "PractitionerController — POST /api/practitioners, GET /api/practitioners/{id}.\n\nCreates and destroys its own practitioner. No patient dependency.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "practitionerId", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const useToken = (token) => pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "const token = pm.environment.get('BEARER_TOKEN');",
          "if (token) {",
          "  useToken(token);",
          "} else {",
          "  pm.sendRequest({",
          "    url: pm.environment.get('baseUrl') + '/api/auth/login',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify({ username: pm.environment.get('username'), password: pm.environment.get('password') }) },",
          "  }, (err, res) => {",
          "    if (err || res.code !== 200) throw new Error('Login failed: ' + (err || res.code));",
          "    pm.environment.set('BEARER_TOKEN', res.json().accessToken);",
          "    useToken(res.json().accessToken);",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "POST Practitioner",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/practitioners",
          "host": ["{{baseUrl}}"],
          "path": ["api", "practitioners"]
        },
        "body": {
          "mode": "raw",
          "options": { "raw": { "language": "json" } },
          "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"Practitioner\",\n  \"specialty\": \"Internal Medicine\",\n  \"npi\": \"1234567890\",\n  \"email\": \"test.practitioner@clinic.test\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "",
              "const body = pm.response.json();",
              "pm.test('Content-Type is application/json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Has id', () => pm.expect(body.id).to.be.a('string').and.not.empty);",
              "pm.test('Fields match', () => {",
              "  pm.expect(body.firstName).to.eql('Test');",
              "  pm.expect(body.lastName).to.eql('Practitioner');",
              "  pm.expect(body.specialty).to.eql('Internal Medicine');",
              "  pm.expect(body.npi).to.eql('1234567890');",
              "  pm.expect(body.email).to.eql('test.practitioner@clinic.test');",
              "});",
              "pm.collectionVariables.set('practitionerId', body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET Practitioner by ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/practitioners/{{practitionerId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "practitioners", "{{practitionerId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "const body = pm.response.json();",
              "pm.test('ID matches', () => pm.expect(body.id).to.eql(pm.collectionVariables.get('practitionerId')));",
              "pm.test('Has no FHIR resourceType', () => pm.expect(body).to.not.have.property('resourceType'));",
              "pm.test('Specialty matches', () => pm.expect(body.specialty).to.eql('Internal Medicine'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Error — POST Practitioner Missing firstName",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/practitioners",
          "host": ["{{baseUrl}}"],
          "path": ["api", "practitioners"]
        },
        "body": {
          "mode": "raw",
          "options": { "raw": { "language": "json" } },
          "raw": "{\n  \"lastName\": \"Smith\",\n  \"specialty\": \"Cardiology\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "",
              "const body = pm.response.json();",
              "pm.test('Error shape: status + message', () => {",
              "  pm.expect(body.status).to.eql(400);",
              "  pm.expect(body.message).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Error — GET Practitioner Not Found",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/practitioners/nonexistent-practitioner-99999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "practitioners", "nonexistent-practitioner-99999"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));",
              "",
              "const body = pm.response.json();",
              "pm.test('Error shape: status + message', () => {",
              "  pm.expect(body.status).to.eql(404);",
              "  pm.expect(body.message).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Teardown — Delete Practitioner",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const pid = pm.collectionVariables.get('practitionerId');",
              "if (!pid) throw new Error('practitionerId is empty — teardown aborted');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Practitioner deleted', () => pm.expect(pm.response.code).to.be.oneOf([200, 204]));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{fhirUrl}}/Practitioner/{{practitionerId}}",
          "host": ["{{fhirUrl}}"],
          "path": ["Practitioner", "{{practitionerId}}"]
        }
      }
    }
  ]
}
