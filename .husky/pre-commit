#!/usr/bin/env sh
# Pre-commit: format staged Java and Angular files, re-stage, then proceed.

ROOT=$(git rev-parse --show-toplevel)

# ── Java (Spotless via Maven) ─────────────────────────────────────────────────
JAVA_STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep '\.java$' || true)

for MODULE in clinic-api payer-api; do
  MODULE_STAGED=$(echo "$JAVA_STAGED" | grep "^$MODULE/" || true)
  if [ -n "$MODULE_STAGED" ]; then
    echo "[pre-commit] Formatting $MODULE Java files with Spotless..."
    (cd "$ROOT/$MODULE" && ./mvnw spotless:apply -q)
    echo "$MODULE_STAGED" | while IFS= read -r file; do
      git add "$ROOT/$file"
    done
    echo "[pre-commit] $MODULE Java formatting done."
  fi
done

# ── Angular / TypeScript (Prettier) ──────────────────────────────────────────
WEB_DIR="$ROOT/care-platform"
WEB_STAGED=$(git diff --cached --name-only --diff-filter=ACM \
  | grep '^care-platform/.*\.\(ts\|html\|scss\|css\|json\)$' || true)

if [ -n "$WEB_STAGED" ] && [ -f "$WEB_DIR/package.json" ]; then
  echo "[pre-commit] Formatting Angular/TS files with Prettier..."
  # Strip the care-platform/ prefix — Prettier runs from inside care-platform/
  RELATIVE=$(echo "$WEB_STAGED" | sed 's|^care-platform/||')
  (cd "$WEB_DIR" && echo "$RELATIVE" | tr '\n' '\0' | xargs -0 npx prettier --write)
  echo "$WEB_STAGED" | while IFS= read -r file; do
    git add "$ROOT/$file"
  done
  echo "[pre-commit] Angular/TS formatting done."
fi
