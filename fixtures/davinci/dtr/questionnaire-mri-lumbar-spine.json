{
  "resourceType": "Questionnaire",
  "id": "mri-lumbar-spine",
  "meta": {
    "profile": [
      "http://hl7.org/fhir/us/davinci-dtr/StructureDefinition/dtr-std-questionnaire"
    ]
  },
  "extension": [
    {
      "url": "http://hl7.org/fhir/us/davinci-dtr/StructureDefinition/questionnaireAudience",
      "valueCode": "clinical"
    },
    {
      "url": "http://hl7.org/fhir/us/davinci-dtr/StructureDefinition/estimated-completion-time",
      "extension": [
        {
          "url": "totalTime",
          "valueCode": "under-5min"
        },
        {
          "url": "clinicalTime",
          "valueCode": "under-5min"
        }
      ]
    },
    {
      "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-launchContext",
      "extension": [
        {
          "url": "name",
          "valueCoding": {
            "system": "http://hl7.org/fhir/uv/sdc/CodeSystem/launchContext",
            "code": "patient"
          }
        },
        {
          "url": "type",
          "valueCode": "Patient"
        }
      ]
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "conditions",
        "language": "application/x-fhir-query",
        "expression": "Condition?patient={{%patient.id}}&clinical-status=active&_count=100"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "medications",
        "language": "application/x-fhir-query",
        "expression": "MedicationStatement?patient={{%patient.id}}&_sort=effective&_count=100"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "encounters",
        "language": "application/x-fhir-query",
        "expression": "Encounter?patient={{%patient.id}}&_sort=date&_count=100"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "reports",
        "language": "application/x-fhir-query",
        "expression": "DiagnosticReport?patient={{%patient.id}}&_sort=-issued&_count=100"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "lumbarCondition",
        "language": "text/fhirpath",
        "expression": "%conditions.entry.resource.where(code.coding.where(code in ('279039007' | '128196005' | '23056005' | '18347007' | '202708005' | '192970008')).exists()).first()"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "nsaids",
        "language": "text/fhirpath",
        "expression": "%medications.entry.resource.where(medication.text.lower().matches('naproxen|ibuprofen|diclofenac|meloxicam|celecoxib'))"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "physicalTherapy",
        "language": "text/fhirpath",
        "expression": "%encounters.entry.resource.where(status = 'finished' and reasonCode.text.lower().contains('physical therapy'))"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "therapyStart",
        "language": "text/fhirpath",
        "expression": "iif(%nsaids.exists() and (%physicalTherapy.empty() or %nsaids.first().effective.start <= %physicalTherapy.first().period.start), %nsaids.first().effective.start, %physicalTherapy.first().period.start)"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "therapyEnd",
        "language": "text/fhirpath",
        "expression": "%physicalTherapy.last().period.start"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "lumbarImaging",
        "language": "text/fhirpath",
        "expression": "%reports.entry.resource.where(code.text.lower().contains('lumbar')).first()"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/cqf-library",
      "valueCanonical": "http://praxishealthplan.example/fhir/Library/mri-lumbar-spine-prepopulation"
    }
  ],
  "url": "http://praxishealthplan.example/fhir/Questionnaire/mri-lumbar-spine",
  "name": "MRILumbarSpine",
  "title": "MRI lumbar spine documentation",
  "status": "active",
  "subjectType": [
    "Patient"
  ],
  "date": "2026-11-01",
  "publisher": "Praxis Health Plan",
  "description": "Documentation Praxis Health Plan needs to review prior authorization for a lumbar spine MRI without contrast.",
  "item": [
    {
      "linkId": "instructions",
      "text": "Praxis Health Plan needs this documentation for a lumbar spine MRI without contrast (CPT 72148).",
      "type": "display"
    },
    {
      "linkId": "clinical-indication",
      "text": "Clinical indication",
      "type": "group",
      "item": [
        {
          "linkId": "primary-diagnosis",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%lumbarCondition.code.text"
              }
            }
          ],
          "text": "Primary diagnosis",
          "type": "open-choice",
          "required": true,
          "answerValueSet": "http://praxishealthplan.example/fhir/ValueSet/lumbar-spine-indications"
        },
        {
          "linkId": "symptom-onset-date",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%lumbarCondition.onset"
              }
            }
          ],
          "text": "When did the symptoms start?",
          "type": "date",
          "required": true
        },
        {
          "linkId": "pain-location",
          "text": "Where is the pain (side and level)?",
          "type": "string"
        }
      ]
    },
    {
      "linkId": "conservative-therapy",
      "text": "Conservative therapy",
      "type": "group",
      "item": [
        {
          "linkId": "conservative-therapy-weeks",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/minValue",
              "valueInteger": 0
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
              "valueInteger": 520
            },
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "iif(%therapyStart.exists() and %therapyEnd.exists(), 0.repeat(iif($this < 520, $this + 1, {})).where(%therapyStart <= %therapyEnd - ($this.toString() + ' weeks').toQuantity()).count(), {})"
              }
            }
          ],
          "text": "How many weeks of conservative therapy has the patient completed?",
          "type": "integer",
          "required": true
        },
        {
          "linkId": "conservative-therapy-types",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%qitem.answerOption.value.where((code = 'physical-therapy' and %physicalTherapy.exists()) or (code = 'nsaids-other-analgesics' and %nsaids.exists()))"
              }
            }
          ],
          "text": "Which conservative therapies were tried?",
          "type": "choice",
          "answerOption": [
            {
              "valueCoding": {
                "system": "http://praxishealthplan.example/fhir/CodeSystem/dtr-answers",
                "code": "physical-therapy",
                "display": "Physical therapy"
              }
            },
            {
              "valueCoding": {
                "system": "http://praxishealthplan.example/fhir/CodeSystem/dtr-answers",
                "code": "nsaids-other-analgesics",
                "display": "NSAIDs or other analgesics"
              }
            },
            {
              "valueCoding": {
                "system": "http://praxishealthplan.example/fhir/CodeSystem/dtr-answers",
                "code": "activity-modification",
                "display": "Activity modification"
              }
            },
            {
              "valueCoding": {
                "system": "http://praxishealthplan.example/fhir/CodeSystem/dtr-answers",
                "code": "chiropractic-care",
                "display": "Chiropractic care"
              }
            },
            {
              "valueCoding": {
                "system": "http://praxishealthplan.example/fhir/CodeSystem/dtr-answers",
                "code": "epidural-steroid-injection",
                "display": "Epidural steroid injection"
              }
            }
          ],
          "repeats": true
        }
      ]
    },
    {
      "linkId": "neurological-findings",
      "text": "Neurological findings",
      "type": "group",
      "item": [
        {
          "linkId": "neurological-deficit",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "iif(%conditions.exists(), %conditions.entry.resource.where(code.coding.where(code in ('192970008' | '6077001')).exists()).exists(), {})"
              }
            }
          ],
          "text": "Does the patient have a progressive or severe neurological deficit?",
          "type": "boolean",
          "required": true
        },
        {
          "linkId": "neurological-deficit-description",
          "text": "Describe the deficit (motor weakness, reflex or sensory loss, bowel or bladder changes).",
          "type": "text",
          "required": true,
          "enableWhen": [
            {
              "question": "neurological-deficit",
              "operator": "=",
              "answerBoolean": true
            }
          ]
        }
      ]
    },
    {
      "linkId": "prior-imaging",
      "text": "Prior imaging",
      "type": "group",
      "item": [
        {
          "linkId": "prior-imaging-done",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "iif(%reports.exists(), %lumbarImaging.exists(), {})"
              }
            }
          ],
          "text": "Has the lumbar spine been imaged before?",
          "type": "boolean",
          "required": true
        },
        {
          "linkId": "prior-imaging-date",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%lumbarImaging.issued"
              }
            }
          ],
          "text": "Date of the most recent imaging",
          "type": "date",
          "enableWhen": [
            {
              "question": "prior-imaging-done",
              "operator": "=",
              "answerBoolean": true
            }
          ]
        }
      ]
    },
    {
      "linkId": "clinical-notes",
      "text": "Anything else the reviewer should know",
      "type": "text"
    }
  ]
}
