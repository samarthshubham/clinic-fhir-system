  "description": "Documentation Praxis Health Plan needs to review prior authorization for an attended in-lab polysomnography.",
  "item": [
    {
      "linkId": "instructions",
      "text": "Praxis Health Plan needs this documentation for an attended in-lab polysomnography (CPT 95810).",
      "type": "display"
    },
    {
      "linkId": "sleep-symptoms",
      "text": "Sleep symptoms",
      "type": "group",
      "item": [
        {
          "linkId": "witnessed-apnea",
          "text": "Has anyone witnessed the patient stop breathing or gasp during sleep?",
          "type": "boolean",
          "required": true
        },
        {
          "linkId": "loud-snoring",
          "text": "Does the patient snore loudly?",
          "type": "boolean"
        },
        {
          "linkId": "epworth-score",
          "text": "Epworth Sleepiness Scale score (0 to 24)",
          "type": "integer",
          "required": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/minValue",
              "valueInteger": 0
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
              "valueInteger": 24
            }
          ]
        }
      ]
    },
    {
      "linkId": "body-measurements",
      "text": "Body measurements",
      "type": "group",
      "item": [
        {
          "linkId": "bmi",
          "text": "Body mass index (kg/m2)",
          "type": "decimal"
        },
        {
          "linkId": "neck-circumference-cm",
          "text": "Neck circumference (cm)",
          "type": "decimal"
        }
      ]
    },
    {
      "linkId": "comorbidities",
      "text": "Comorbidities",
      "type": "choice",
      "answerValueSet": "http://praxishealthplan.example/fhir/ValueSet/sleep-study-comorbidities",
      "repeats": true
    },
    {
      "linkId": "home-sleep-test-done",
      "text": "Has the patient had a home sleep apnea test?",
      "type": "boolean",
      "required": true
    },
    {
      "linkId": "home-sleep-test-result",
      "text": "Result of the home sleep apnea test",
      "type": "choice",
      "required": true,
      "enableWhen": [
        {
          "question": "home-sleep-test-done",
          "operator": "=",
          "answerBoolean": true
        }
      ],
